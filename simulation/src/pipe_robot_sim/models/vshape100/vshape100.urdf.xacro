<?xml version="1.0"?>
<!-- V자형 100mm 배관 로봇 (arXiv 2603.27245, docs/09 참고)
     구조: 링크 2개를 토션 스프링 관절(꼭짓점 O)로 이은 V자.
       - 양 끝에 옴니휠 한 쌍씩 (4개 모두 구동, 원 논문은 모터 1개 + 타이밍 벨트) -> 아래 벽
       - 링크 1 위에 구형 바퀴 (굴림 모터가 링크 1 방향 축으로 돌림) -> 위 벽, 로봇을 배관 축 둘레로 굴림
     좌표: 배관 축 = x (앞 = 링크 1 쪽), 위 = z. base_link = 링크 1.
           base_link 원점은 꼭짓점 O 바로 아래 배관 중심선 위 (스폰 위치와 맞추기 위해).
     관절 0 = 배관 안 기준 자세 (논문 시제품: 링크 1이 배관 축과 1.6° 기울어짐 -> 거의 펴진 V).
     [논문 값] L1, L2, 옴니휠 반경, 구형 바퀴 반경, 스프링 강성, 총 질량, 마찰계수(해석값)
     [추정] 아래 '추정' 주석이 붙은 값. 실측·원저자 확인 전까지 바꿔 가며 시험할 것 -->
<robot name="vshape100" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="pipe_inner_d" default="0.1008"/>
  <xacro:arg name="params_file" default=""/>
  <xacro:arg name="suspension" default="all"/>
  <!-- 뒤 옴니휠 구동 여부. false = 전륜 구동 (뒤 바퀴는 모터 없이 자유 회전). vshape100_fwd 가 false 로 씀 -->
  <xacro:arg name="rear_drive" default="true"/>
  <xacro:include filename="$(find pipe_robot_sim)/models/common/common.xacro"/>

  <!-- ===== 치수 ===== -->
  <xacro:property name="Rp" value="${$(arg pipe_inner_d)/2}"/>   <!-- 배관 내반경 -->
  <xacro:property name="L1" value="0.105"/>        <!-- 링크 1: O ~ 앞 옴니휠 축 (논문) -->
  <xacro:property name="L2" value="0.075"/>        <!-- 링크 2: O ~ 뒤 옴니휠 축 (논문) -->
  <xacro:property name="Ro" value="0.030"/>        <!-- 옴니휠 반경 (논문) -->
  <xacro:property name="Rs" value="0.0225"/>       <!-- 구형 바퀴 반경 (논문) -->
  <xacro:property name="Wo" value="0.066"/>        <!-- 좌우 옴니휠 중심 간격. 추정: 논문 Fig.4a 비율 Wo/Dp = 0.66 -->
  <xacro:property name="o_w" value="0.014"/>       <!-- 옴니휠 폭. 추정 -->
  <xacro:property name="o_row" value="0.0"/>       <!-- 롤러 두 줄 간격의 절반. 0 = 한 평면 (구 롤러로 둥근 둘레를 만들기 위함, common.xacro) -->
  <xacro:property name="o_rr" value="0.0055"/>     <!-- 롤러 반경. 추정 -->
  <xacro:property name="o_n" value="8"/>           <!-- 줄당 롤러 수 (2줄 = 16개). 실물(사진)은 약 10개지만 구 롤러 근사라 늘림 -->
  <xacro:property name="alpha1" value="${radians(1.6)}"/>   <!-- 링크 1 기울기 (논문 시제품 |α| ≈ 1.6°) -->
  <xacro:property name="ds" value="0.025"/>        <!-- O에서 링크 1 방향으로 구형 바퀴 중심까지. 추정: 사진 -->
  <xacro:property name="body_w" value="0.040"/>    <!-- 몸통 폭. 추정 -->
  <xacro:property name="body_h" value="0.018"/>    <!-- 몸통 높이. 추정 (구형 바퀴 아래에 들어가게) -->

  <!-- 스프링: 10.06 N·mm/deg = 0.5764 N·m/rad (논문). 자유 상태 각 -1.1 rad: 추정 (사진에서 두 링크가 약 29°, 39° 벌어짐) -->
  <xacro:property name="spring_k" value="0.5764"/>
  <xacro:property name="spring_ref" value="-1.1"/>

  <!-- 질량 (총 750 g, 논문). 배분은 추정 -->
  <xacro:property name="m1" value="0.24"/>         <!-- 링크 1: 굴림 모터, 회로 -->
  <xacro:property name="m2" value="0.134"/>         <!-- 링크 2: 추진 모터 -->
  <xacro:property name="m_hub" value="0.015"/>
  <xacro:property name="m_roller" value="0.004"/>
  <xacro:property name="m_sph" value="0.05"/>   <!-- + 허브 0.01 -->

  <!-- 마찰: 옴니 μo = 0.3 (논문 안정성 해석값).
       구형 바퀴: 논문은 "하이브리드 마찰 소재" (해석값 μs = 0.1). 몸통을 굴리는 방향은 잡고 진행 방향은 미끄러져야 함.
       시뮬에서는 진행 방향으로 자유 회전하는 축을 하나 더 두어 (roll_free_joint) 같은 효과를 내고, 마찰은 0.6 (추정).
       μ 하나로 두면: 0.1 은 롤을 못 잡고 (엘보에서 넘어감), 0.6 은 전진을 막음 (2026-10-20 시험, docs/06) -->
  <xacro:property name="mu_omni" value="0.3"/>
  <xacro:property name="mu_sph" value="0.6"/>

  <!-- 구동: 바퀴 관절 감쇠 = 스톨 토크 / 무부하 속도 (robot.yaml 과 같게). 모터 사양 미기재 -> 추정 0.3 N·m / 10 rad/s -->
  <xacro:property name="wheel_damping" value="${0.3/10.0}"/>
  <xacro:property name="rear_damping" value="${wheel_damping}"/>
  <!-- 굴림 모터 (구형 바퀴): 스톨 0.15 N·m / 무부하 15 rad/s 추정 -> 감쇠 0.01 (속도 상한 역할) -->
  <xacro:property name="roll_damping" value="${0.15/15.0}"/>
  <xacro:unless value="$(arg rear_drive)">
    <xacro:property name="rear_damping" value="0.001"/>   <!-- 모터 없는 바퀴: 베어링 마찰 정도 -->
  </xacro:unless>

  <!-- ===== 기준 자세 계산 =====
       옴니휠: 바깥 롤러 줄(y = Wo/2 + o_row)이 벽에 닿는 높이
       O: 앞 바퀴 축에서 링크 1을 따라 L1, 기울기 alpha1
       링크 2: 두 바퀴 축 높이가 같도록 alpha2 (L1 sin α1 = L2 sin α2, 논문 식)
       구형 바퀴: 위 벽에 닿음 (중심 z = Rp - Rs), 링크 1에서 수직으로 e 만큼 떨어진 브래킷 -->
  <xacro:property name="yc" value="${Wo/2 + o_row}"/>
  <xacro:property name="zw" value="${-sqrt((Rp - o_rr)*(Rp - o_rr) - yc*yc) + (Ro - o_rr)}"/>
  <xacro:property name="zO" value="${zw + L1*sin(alpha1)}"/>
  <xacro:property name="alpha2" value="${asin(L1*sin(alpha1)/L2)}"/>
  <xacro:property name="zs" value="${Rp - Rs}"/>
  <xacro:property name="e_off" value="${(zs - zO + ds*sin(alpha1))/cos(alpha1)}"/>
  <xacro:property name="xs" value="${ds*cos(alpha1) + e_off*sin(alpha1)}"/>

  <!-- ===== 링크 1 (base_link) ===== -->
  <xacro:property name="l1b" value="${L1 - 0.02}"/>
  <link name="base_link">
    <!-- 몸통: O에서 앞 바퀴 쪽으로, 구형 바퀴 밑으로 지나가게 링크 선보다 3.5 mm 아래 -->
    <visual>
      <origin xyz="${l1b/2*cos(alpha1) - 0.0035*sin(alpha1)} 0 ${zO - l1b/2*sin(alpha1) - 0.0035*cos(alpha1)}" rpy="0 ${alpha1} 0"/>
      <geometry><box size="${l1b} ${body_w} ${body_h}"/></geometry>
      <material name="body_white"><color rgba="0.92 0.92 0.92 1"/></material>
    </visual>
    <collision>
      <origin xyz="${l1b/2*cos(alpha1) - 0.0035*sin(alpha1)} 0 ${zO - l1b/2*sin(alpha1) - 0.0035*cos(alpha1)}" rpy="0 ${alpha1} 0"/>
      <geometry><box size="${l1b} ${body_w} ${body_h}"/></geometry>
    </collision>
    <!-- 굴림 모터 (링크 1 방향, 몸통 위 앞쪽) -->
    <visual>
      <origin xyz="${0.07*cos(alpha1) + 0.016*sin(alpha1)} 0 ${zO - 0.07*sin(alpha1) + 0.016*cos(alpha1)}" rpy="0 ${pi/2 + alpha1} 0"/>
      <geometry><cylinder radius="0.010" length="0.035"/></geometry>
      <material name="motor_grey"><color rgba="0.55 0.55 0.6 1"/></material>
    </visual>
    <!-- 구형 바퀴 브래킷 -->
    <visual>
      <origin xyz="${xs} 0 ${(zO + zs)/2}" rpy="0 0 0"/>
      <geometry><box size="0.008 0.020 ${zs - zO}"/></geometry>
      <material name="body_white"/>
    </visual>
    <xacro:inertial_box m="${m1}" x="${l1b}" y="${body_w}" z="${body_h}"
                        xyz="${l1b/2*cos(alpha1)} 0 ${zO - l1b/2*sin(alpha1)}" rpy="0 ${alpha1} 0"/>
  </link>

  <!-- 구형 바퀴: 링크 1 방향 축 (굴림 모터, 구동) -> 허브 -> 진행 방향 자유 축 -> 바퀴 -->
  <joint name="roll_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="roll_hub"/>
    <origin xyz="${xs} 0 ${zs}" rpy="0 ${alpha1} 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="${roll_damping}" friction="0"/>
  </joint>
  <link name="roll_hub">
    <xacro:inertial_sphere m="0.01" r="0.008"/>
  </link>
  <joint name="roll_free_joint" type="continuous">
    <parent link="roll_hub"/>
    <child link="roll_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0005" friction="0"/>
  </joint>
  <link name="roll_wheel">
    <visual>
      <geometry><sphere radius="${Rs}"/></geometry>
      <material name="ball_red"><color rgba="0.85 0.2 0.15 1"/></material>
    </visual>
    <!-- 굴림이 보이게 하는 표시 띠 -->
    <visual>
      <geometry><box size="0.004 ${2*Rs*1.01} 0.006"/></geometry>
      <material name="motor_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${Rs}"/></geometry>
    </collision>
    <xacro:inertial_sphere m="${m_sph}" r="${Rs}"/>
  </link>
  <xacro:friction link="roll_wheel" mu="${mu_sph}"/>

  <!-- 앞 옴니휠 쌍 -->
  <xacro:omni_wheel name="front_left_omni" parent="base_link" xyz="${L1*cos(alpha1)} ${Wo/2} ${zw}"
                    R="${Ro}" width="${o_w}" n="${o_n}" rr="${o_rr}" row="${o_row}"
                    hub_mass="${m_hub}" roller_mass="${m_roller}" mu="${mu_omni}" damping="${wheel_damping}"/>
  <xacro:omni_wheel name="front_right_omni" parent="base_link" xyz="${L1*cos(alpha1)} ${-Wo/2} ${zw}"
                    R="${Ro}" width="${o_w}" n="${o_n}" rr="${o_rr}" row="${o_row}"
                    hub_mass="${m_hub}" roller_mass="${m_roller}" mu="${mu_omni}" damping="${wheel_damping}"/>

  <!-- ===== V 관절 (토션 스프링) =====
       q > 0: 뒤 바퀴가 올라감 (V가 펴지다 반대로 꺾임), q < 0: V가 벌어짐. 스프링은 q = spring_ref 쪽으로 벌림 -->
  <joint name="v_joint" type="revolute">
    <parent link="base_link"/>
    <child link="link2"/>
    <origin xyz="0 0 ${zO}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.15" upper="0.8" effort="5.0" velocity="10.0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>
  <xacro:joint_spring joint="v_joint" k="${spring_k}" ref="${spring_ref}"/>

  <!-- ===== 링크 2 ===== -->
  <xacro:property name="l2b" value="${L2 - 0.02}"/>
  <link name="link2">
    <visual>
      <origin xyz="${-l2b/2*cos(alpha2)} 0 ${-l2b/2*sin(alpha2) - 0.0035}" rpy="0 ${-alpha2} 0"/>
      <geometry><box size="${l2b} ${body_w} ${body_h}"/></geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="${-l2b/2*cos(alpha2)} 0 ${-l2b/2*sin(alpha2) - 0.0035}" rpy="0 ${-alpha2} 0"/>
      <geometry><box size="${l2b} ${body_w} ${body_h}"/></geometry>
    </collision>
    <!-- 추진 모터 (몸통 아래) -->
    <visual>
      <origin xyz="-0.030 0 ${-0.030*sin(alpha2) - 0.016}" rpy="0 ${pi/2 - alpha2} 0"/>
      <geometry><cylinder radius="0.009" length="0.030"/></geometry>
      <material name="motor_grey"/>
    </visual>
    <xacro:inertial_box m="${m2}" x="${l2b}" y="${body_w}" z="${body_h}"
                        xyz="${-l2b/2*cos(alpha2)} 0 ${-l2b/2*sin(alpha2)}" rpy="0 ${-alpha2} 0"/>
  </link>

  <!-- 뒤 옴니휠 쌍 -->
  <xacro:omni_wheel name="rear_left_omni" parent="link2" xyz="${-L2*cos(alpha2)} ${Wo/2} ${zw - zO}"
                    R="${Ro}" width="${o_w}" n="${o_n}" rr="${o_rr}" row="${o_row}"
                    hub_mass="${m_hub}" roller_mass="${m_roller}" mu="${mu_omni}" damping="${rear_damping}"/>
  <xacro:omni_wheel name="rear_right_omni" parent="link2" xyz="${-L2*cos(alpha2)} ${-Wo/2} ${zw - zO}"
                    R="${Ro}" width="${o_w}" n="${o_n}" rr="${o_rr}" row="${o_row}"
                    hub_mass="${m_hub}" roller_mass="${m_roller}" mu="${mu_omni}" damping="${rear_damping}"/>

  <!-- ===== 시뮬 플러그인 ===== -->
  <xacro:sim_common imu_parent="base_link" imu_xyz="0.05 0 0"/>
  <xacro:joint_force joint="front_left_omni_joint"/>
  <xacro:joint_force joint="front_right_omni_joint"/>
  <xacro:if value="$(arg rear_drive)">
    <xacro:joint_force joint="rear_left_omni_joint"/>
    <xacro:joint_force joint="rear_right_omni_joint"/>
  </xacro:if>
  <xacro:joint_force joint="roll_wheel_joint"/>
</robot>
