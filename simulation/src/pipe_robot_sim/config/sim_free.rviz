Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/MarkerArray
      Name: Pipe
      Enabled: true
      Topic:
        Value: /pipe_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (정답 위치)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.05
      Frames:
        All Enabled: false
        world: {Value: true}
        base_link: {Value: true}
        base_link_est: {Value: true}
    - Class: rviz_default_plugins/PointCloud2
      Name: ToF 전방 8x8
      Enabled: true
      Topic:
        Value: /tof/front/points
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.006
      Color Transformer: FlatColor
      Color: 255; 0; 255
    - Class: rviz_default_plugins/LaserScan
      Name: ToF 왼쪽
      Enabled: true
      Topic:
        Value: /tof/left
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.008
      Color Transformer: FlatColor
      Color: 0; 255; 255
    - Class: rviz_default_plugins/LaserScan
      Name: ToF 오른쪽
      Enabled: true
      Topic:
        Value: /tof/right
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.008
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Path
      Name: 정답 경로
      Enabled: true
      Color: 50; 200; 50
      Topic:
        Value: /ground_truth/path
    - Class: rviz_default_plugins/Path
      Name: 추정 경로 (엔코더+IMU)
      Enabled: true
      Color: 230; 50; 50
      Topic:
        Value: /odom_path
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  # 자유 시점: 카메라가 로봇을 따라가지 않음 (Target Frame = world).
  # 왼쪽 끌기 = 회전, 가운데(또는 Shift+왼쪽) 끌기 = 이동, 휠 = 확대/축소
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.9
      Focal Point: {X: 0.7, Y: 0.1, Z: 0.057}
      Pitch: 0.55
      Yaw: 4.0
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 860
